# Training site sign-in (see .env.deployment.staging). Dev's training
# CloudFront stamps X-VCS-Site=faculty on the Lambda origin, so the faculty
# domain rule must be set here too or every training call is refused.
TRAINING_AUTH_REQUIRED=true
TRAINING_PUBLIC_URL=https://d3dghqhnk7aoku.cloudfront.net
FACULTY_ENTRA_ALLOWED_EMAIL_DOMAINS=staff.main.ntu.edu.sg,assoc.main.ntu.edu.sg
# Open live chats on the dev gateway keep the dev GPU on (deployed 2026-11-16).
GPU_GATEWAY_ACTIVITY_URL=http://voice-gpu-alb-815777974.ap-northeast-2.elb.amazonaws.com/api/live/session/activity

