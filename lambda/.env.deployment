LIVE_AUTH_ENABLED=true
LIVE_AUTH_DEMO_ONLY=true
ENTRA_TENANT_ID=15ce9348-be2a-462b-8fc0-e1765a9b204a
ENTRA_AUDIENCE=9b5c52c0-5f02-4dbf-83ac-c68d246abc68
ENTRA_ALLOWED_EMAIL_DOMAINS=staff.main.ntu.edu.sg,student.main.ntu.edu.sg,assoc.main.ntu.edu.sg,ntu.edu.sg
LEARNER_TABLE_NAME=vcs-dev-transcripts
LEARNER_TABLE_REGION=ap-northeast-2
LEARNER_TTL_DAYS=90
SUPERVISOR_APP_ROLE=Supervisor
# The original Dev GPU remains activity-managed. A separate routing-test GPU is
# manual-only and is intentionally not referenced by GPU_INSTANCE_ID, so this
# Lambda's idle checks cannot stop it.
GPU_IDLE_STOP_MINUTES=40
GPU_SCHEDULE_ENABLED=false
GPU_INSTANCE_ID=i-03f258d470a2fa73f
GPU_INSTANCE_REGION=ap-northeast-2
GPU_WORKER_PUBLIC_URL=https://doovx82fh9tfs.cloudfront.net
GPU_WORKER_URL=http://voice-gpu-alb-815777974.ap-northeast-2.elb.amazonaws.com
GPU_FIXED_INFERENCE_ACTIVITY_URL=http://voice-gpu-alb-815777974.ap-northeast-2.elb.amazonaws.com/fixed-inference/activity/status
MODEL_COORDINATOR_FUNCTION_NAME=Liu_Teng_Yu_Intern2026-Voice_Cloning_Project-dev-coordinator
MODEL_SOURCE=s3
S3_BUCKET=interns2026-small-projects-bucket-shared
S3_PREFIX=echolect/
S3_REGION=ap-southeast-1

# Training site sign-in (see .env.deployment.staging). Dev's training
# CloudFront stamps X-VCS-Site=faculty on the Lambda origin, so the faculty
# domain rule must be set here too or every training call is refused.
TRAINING_AUTH_REQUIRED=true
TRAINING_PUBLIC_URL=https://d3dghqhnk7aoku.cloudfront.net
FACULTY_ENTRA_ALLOWED_EMAIL_DOMAINS=staff.main.ntu.edu.sg,assoc.main.ntu.edu.sg,ntu.edu.sg
# Open live chats on the dev gateway keep the dev GPU on (deployed 2026-11-16).
GPU_GATEWAY_ACTIVITY_URL=http://voice-gpu-alb-815777974.ap-northeast-2.elb.amazonaws.com/api/live/session/activity

# Voice Studio (lambda/studio). Super users in this list are locked (cannot be removed in the UI).
STUDIO_SUPERUSERS=lkc-digitallearning@ntu.edu.sg,cs-tengyu.liu@assoc.main.ntu.edu.sg
STUDIO_RECORD_URL=https://d1zffrwq7b2rri.cloudfront.net
STUDIO_PUBLIC_URL=https://d1zffrwq7b2rri.cloudfront.net
# Voice Studio: picking a voice switches the one GPU at once (no 10 min protection).
TTS_SITE_ORIGINS=https://d1zffrwq7b2rri.cloudfront.net
# Voice Studio pages (by browser Origin) accept any Microsoft account (work, school or
# personal, incl. a Gmail registered as one). Empty STUDIO_ALLOWED_EMAIL_DOMAINS = any.
# STUDIO_HOME_DOMAINS: addresses only NTU's own tenant may assert.
STUDIO_SITE_ORIGINS=https://d1zffrwq7b2rri.cloudfront.net
STUDIO_ALLOWED_EMAIL_DOMAINS=
STUDIO_HOME_DOMAINS=ntu.edu.sg
# Voice Studio email + password sign-in: public half of the session signing key.
# The private half (STUDIO_SESSION_PRIVATE_KEY) is set only on the live function, never in git.
STUDIO_SESSION_PUBLIC_KEY=MCowBQYDK2VwAyEAMfzeB9FoM/iCucExS1cc7NeO5Az81ODDPxR/EN//5jE=
# Recording Part 2 (specialty terms): "Generate with AI" calls OpenAI with OPENAI_API_KEY, set ONLY on
# the live function, never in git (without it Generate answers 503; paste/upload still work).
# STUDIO_TERMS_MODEL optionally overrides the model (default gpt-4.1-mini).

# Voice Studio email: the LKC Office 365 mailbox (SMTP AUTH, STARTTLS on 587). EMAIL_PASS is an app password set ONLY on the live
# function (scripts/set-email-password.ps1), never in git.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=lkc-digitallearning@ntu.edu.sg
EMAIL_FROM="LKCMedicine Voice Studio" <lkc-digitallearning@ntu.edu.sg>
# Amazon SES (2026-11-24): sends as EMAIL_FROM (verified in SES us-east-1) with the Lambda role; SMTP above is the fallback.
EMAIL_PROVIDER=ses
SES_REGION=us-east-1
