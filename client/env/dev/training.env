# Training site: train a voice + "Test your voice". Dev CloudFront E2KTGN0G56FW71.
#
# Origin-agnostic: blank URLs make /api, /train/progress and the live-chat
# socket resolve against whichever host served the page, so the CloudFront
# hostname and the lkcmedicine.org alias both work without cross-origin calls.
VITE_APP_MODE=training
VITE_APP_BASENAME=/
VITE_API_BASE_URL=
VITE_GPU_WORKER_URL=
VITE_LIVE_GATEWAY_URL=

# Microsoft SSO, NTU staff/associate accounts only. The Lambda and gateway
# enforce the same rule (the CloudFront origins stamp X-VCS-Site=faculty).
VITE_AUTH_ENABLED=true
VITE_AUTH_MODE=msal
VITE_ENTRA_CLIENT_ID=9b5c52c0-5f02-4dbf-83ac-c68d246abc68
VITE_ENTRA_TENANT_AUTHORITY=https://login.microsoftonline.com/common
VITE_ENTRA_ALLOWED_EMAIL_DOMAINS=staff.main.ntu.edu.sg,assoc.main.ntu.edu.sg
VITE_API_AUTH_MODE=entra-id

# Dev trains and synthesises on one GPU, so the test tab warns while a run is active.
VITE_TRAINING_SHARES_INFERENCE_GPU=true
VITE_SHOW_ADVANCED_SETTINGS=true
