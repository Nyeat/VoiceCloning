# Voice Studio — studio portal: super users review/book slots; lecturers test their approved voice in their slot.
# CloudFront: see scripts/deploy.config.json (staging.studio).
#
# Origin-agnostic: blank URLs make /api and the live-chat socket resolve
# against the CloudFront host that served the page.
VITE_APP_MODE=studio
VITE_APP_BASENAME=/
VITE_API_BASE_URL=
VITE_GPU_WORKER_URL=
VITE_LIVE_GATEWAY_URL=

# Microsoft SSO, NTU staff/associate accounts only (same Entra app as training).
# Each new CloudFront URL must be added as an SPA redirect URI on that app.
VITE_AUTH_ENABLED=true
VITE_AUTH_MODE=msal
VITE_ENTRA_CLIENT_ID=9b5c52c0-5f02-4dbf-83ac-c68d246abc68
VITE_ENTRA_TENANT_AUTHORITY=https://login.microsoftonline.com/common
VITE_ENTRA_ALLOWED_EMAIL_DOMAINS=staff.main.ntu.edu.sg,assoc.main.ntu.edu.sg,ntu.edu.sg
VITE_API_AUTH_MODE=entra-id

# Cross-links between the two Voice Studio sites (set once the CloudFronts exist).
VITE_RECORD_APP_URL=https://d271zk8d8curic.cloudfront.net
VITE_STUDIO_APP_URL=https://d271zk8d8curic.cloudfront.net

VITE_TRAINING_SHARES_INFERENCE_GPU=false
VITE_SHOW_ADVANCED_SETTINGS=false
VITE_GPU_AUTO_START=false
